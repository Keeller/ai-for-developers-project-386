{
  "name": "@calendar/api-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./generated/schema.d.ts",
  "exports": {
    ".": {
      "types": "./generated/schema.d.ts"
    }
  },
  "scripts": {
    "build": "npm run generate",
    "generate": "npm run generate:openapi && npm run generate:types",
    "generate:openapi": "tsp compile .",
    "generate:types": "openapi-typescript generated/openapi.yaml --output generated/schema.d.ts --export-type",
    "check": "npm run generate && git diff --exit-code -- generated"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "openapi-typescript": "^7.13.0"
  }
}
